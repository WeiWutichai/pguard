# pguard otp-service — environment template.
# Copy to .env and fill in real values. NEVER commit real secrets.

# --- Postgres (otp schema) ---
DATABASE_URL=postgres://pguard:pguard_dev_pw@localhost:5433/pguard
# DATABASE_MAX_CONNECTIONS=20

# --- Redis (captcha / cooldown / daily cap / lockout / phone-verify jti) ---
REDIS_CACHE_URL=redis://:redis_dev_pw@localhost:6379

# --- JWT (used ONLY to sign the single-use phone-verified token) ---
# Must be >= 64 chars. Same secret the rest of the platform validates user tokens with.
JWT_SECRET=replace-with-a-64-char-minimum-random-secret-do-not-use-this-value!!

# --- INET SMS gateway (Cheese Digital Network CSGAPI) ---
# Gateway: https://bulksms.cheesemobile.com/v2/  (param: username, passwd, from, to, text)
# Required UNLESS SMS_DISABLED is set; the service fails fast at startup if missing.
INET_SMS_USERNAME=your-csgapi-username
INET_SMS_PASSWORD=your-csgapi-password
INET_SMS_SENDER=GuardApp
INET_SMS_URL=https://bulksms.cheesemobile.com/v2/

# Dev escape hatch: set to 1 to skip the real gateway and use the NoopSender
# (logs instead of sending). Leave UNSET in production.
# SMS_DISABLED=1

# --- OTP policy (all optional; defaults shown) ---
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_SECONDS=60
PHONE_VERIFY_TTL_MINUTES=10
DAILY_OTP_LIMIT=10

# --- CORS (comma-separated allowed origins; defaults to http://localhost:3000) ---
# CORS_ALLOWED_ORIGINS=http://localhost:3000
