# pguard v2 scaffold stub — web-admin environment example.
# Copy to .env.local (gitignored) for local dev. Do NOT commit real secrets.

# Public: base URL of the api-gateway (browser-visible, so no secrets here).
# All requests are versioned under /v1/ at the gateway (see CLAUDE.md).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1

# Public: active default locale for bilingual TH/EN UI (th | en).
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Server-only: internal gateway URL used by server components / route handlers.
# Auth cookies are httpOnly and forwarded server-side; never expose tokens to JS.
API_GATEWAY_INTERNAL_URL=http://api-gateway:8080/v1

# Server-only: name of the CSRF cookie/header pair for state-changing requests.
CSRF_HEADER_NAME=x-csrf-token
