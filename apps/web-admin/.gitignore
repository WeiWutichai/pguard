# pguard v2 scaffold stub — web-admin .gitignore

# dependencies
/node_modules
/.pnp
.pnp.*

# next.js build output
/.next/
/out/
next-env.d.ts

# production
/build

# Generated API client (regenerated from contracts/openapi via `pnpm gen:api`).
# COMMITTED (not ignored): the prod Docker builder copies only apps/web-admin/ (not the
# contracts/ dir), so it can't regenerate at build time — committing the client is what keeps
# `pnpm build` reproducible there. Re-run `pnpm gen:api` whenever the OpenAPI contracts change.

# env (never commit real secrets; .env.example is the template)
.env
.env.local
.env*.local

# misc
.DS_Store
*.tsbuildinfo
