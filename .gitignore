# Build artifacts
target/
build/
dist/
out/
.next/
*.dSYM/

# Dependency caches
node_modules/
.pub-cache/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub/
# Cargo.lock IS committed: this workspace ships BINARY services (not a library), so the lock is
# the reproducible-build + `cargo audit` source of truth (Rust convention for bins). See
# .github/workflows/ci.yml (cargo audit) + docs/SECRET-ROTATION.md / PENTEST-CHECKLIST.md.

# Env files
.env
.env.local
.env.*.local
# Real per-environment secret files (the *.example templates ARE committed).
.env.staging
.env.prod

# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
.thumbnail

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/
*.lcov
target/coverage/

# Claude scratch
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/agent-memory/*/scratch/

# Generated code from OpenAPI/AsyncAPI.
# Rust Axum handler stubs target is SKIPPED (services are hand-written; see tooling/codegen) —
# its dir stays ignored so a stray local experiment can't leak in.
packages/shared-rust/src/generated/
# COMMITTED (not ignored), like the web-admin TS client: the generated artifacts are checked in so
# the CI stale-check can `git diff --exit-code` after regenerating (catch a contract edited without
# `./tooling/codegen/generate.sh`). Re-run the generator when contracts change.
#   - packages/shared-events/src/generated/  (Rust event payload types — committed)
#   - apps/mobile/lib/api/generated/         (Dart client packages — committed; their *.g.dart
#                                             build_runner outputs stay ignored by the rule below)
# NOTE: apps/web-admin/src/api/generated/ is likewise COMMITTED — the prod web-admin Docker builder
# copies only apps/web-admin/ (no contracts/ dir) so it can't regenerate at build time.

# Local secrets
secrets/
*.pem
*.key
!*.example

# Design handoff bundle (kept local, not tracked in git)
redesign-pguard/

# perf-harness local env (throwaway secrets — never committed)
.env.perf

# Firebase mobile config (client API key; local build only — CI does not build the APK)
apps/mobile/android/app/google-services.json
apps/mobile/ios/Runner/GoogleService-Info.plist
dump.rdb

# Versioned APK build artifacts + local build log (tooling/scripts/build-apk.sh)
apps/mobile/dist/
