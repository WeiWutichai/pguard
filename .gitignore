# Build artifacts
target/
build/
dist/
out/
.next/
*.dSYM/

# Dependency caches
node_modules/
.pub-cache/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub/
Cargo.lock

# Env files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
.thumbnail

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/
*.lcov
target/coverage/

# Claude scratch
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/agent-memory/*/scratch/

# Generated code from OpenAPI (commit only source specs)
packages/shared-rust/src/generated/
packages/shared-events/src/generated/
apps/mobile/lib/api/generated/
# NOTE: apps/web-admin/src/api/generated/ is intentionally COMMITTED (not ignored) — the prod
# web-admin Docker builder copies only apps/web-admin/ (no contracts/ dir) so it can't regenerate
# at build time. Re-run `pnpm gen:api` when contracts change. See apps/web-admin/.gitignore.

# Local secrets
secrets/
*.pem
*.key
!*.example

# Design handoff bundle (kept local, not tracked in git)
redesign-pguard/

# perf-harness local env (throwaway secrets — never committed)
.env.perf
