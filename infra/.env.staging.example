# ─────────────────────────────────────────────────────────────────────────────
# pguard v2 — STAGING environment (TEMPLATE).
#
#   cp infra/.env.staging.example infra/.env.staging   # the real file is GITIGNORED
#   # …replace every CHANGE_ME__* placeholder below with a real value…
#   set -a; source infra/.env.staging; set +a          # export into the shell
#
# Used by `docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml`.
# Every var the compose marks `${VAR:?}` MUST be present here or `config`/`up` fails
# fast. The ≥64-char secrets are length-checked by the apps at boot. Generate each
# secret freshly and uniquely:
#
#   openssl rand -hex 48     # 96 hex chars — for the JWT / service-JWT / event-signing keys
#   openssl rand -base64 24  # for DB / MinIO / Grafana passwords
#
# DO NOT reuse v1 secrets, dev secrets, or the same value across two variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Image coordinates (where to PULL the 14 custom images from) ──────────────
# REGISTRY defaults to ghcr.io if unset. IMAGE_PREFIX is the LOWERCASE owner/repo
# (ghcr rejects uppercase paths — CI downcases `WeiWutichai/pguard`). IMAGE_TAG is
# the git SHA pushed by .github/workflows/deploy.yml (recommended for rollbacks) or
# `latest`. These are usually exported on the command line at deploy time, but are
# listed here so a single `source infra/.env.staging` is enough.
REGISTRY=ghcr.io
IMAGE_PREFIX=weiwutichai/pguard
IMAGE_TAG=latest

# ── PostgreSQL (primary + streaming read replica) ────────────────────────────
POSTGRES_USER=pguard
POSTGRES_DB=pguard
# Primary superuser password.
POSTGRES_PASSWORD=CHANGE_ME__db_password
# Password for the dedicated `replicator` role the standby streams as (C5.3).
REPLICATION_PASSWORD=CHANGE_ME__replication_password

# ── App secrets (≥64 chars each, DEDICATED — never share one across two) ──────
# Every Rust service validates JWT_SECRET ≥64 at startup and exits otherwise.
JWT_SECRET=CHANGE_ME__openssl_rand_hex_48
# Internal service-to-service JWT (sub="<svc>-service"). Separate from JWT_SECRET.
SERVICE_JWT_SECRET=CHANGE_ME__openssl_rand_hex_48
# HMAC key for signed NATS event envelopes (shared-events) — producers sign,
# consumers verify, so a forged event is rejected. DEDICATED, ≥64 chars.
EVENT_SIGNING_SECRET=CHANGE_ME__openssl_rand_hex_48
# AES-256 key (EXACTLY 64 hex chars / 32 bytes) sealing the per-user TOTP 2FA secret at
# rest in identity (#144). DEDICATED — generate with `openssl rand -hex 32`.
TOTP_ENC_KEY=CHANGE_ME__openssl_rand_hex_32

# ── NATS per-service credentials (server-side subject ACL, infra/docker/nats.conf) ──
# ⚠️ NATS config parser ตีความค่าที่ขึ้นต้นด้วยตัวเลขเป็น number แล้ว boot fail
# (เจอจริงบน staging 2026-06-10) — generate ด้วย prefix ตัวอักษรเสมอ:
#   np$(openssl rand -hex 23)
# Each service connects as ITS OWN NATS user; the broker enforces least-privilege subject
# permissions (a compromised container can only publish its own context). ONE distinct
# password per user — a shared password would let a compromised container impersonate a
# more-privileged service. Generate each with `openssl rand -hex 24`. Rotate per
# docs/SECRET-ROTATION.md. NOT required in local dev (the dev nats has no auth).
NATS_BOOKING_PASSWORD=CHANGE_ME__np_PLUS_openssl_rand_hex_23
NATS_PAYMENT_PASSWORD=CHANGE_ME__np_PLUS_openssl_rand_hex_23
NATS_RATING_PASSWORD=CHANGE_ME__np_PLUS_openssl_rand_hex_23
NATS_CALLING_PASSWORD=CHANGE_ME__np_PLUS_openssl_rand_hex_23
NATS_CHAT_PASSWORD=CHANGE_ME__np_PLUS_openssl_rand_hex_23
NATS_PROFILE_PASSWORD=CHANGE_ME__np_PLUS_openssl_rand_hex_23
NATS_IDENTITY_PASSWORD=CHANGE_ME__np_PLUS_openssl_rand_hex_23
NATS_NOTIFICATION_PASSWORD=CHANGE_ME__np_PLUS_openssl_rand_hex_23
NATS_PRESENCE_PASSWORD=CHANGE_ME__np_PLUS_openssl_rand_hex_23
NATS_GATEWAY_PASSWORD=CHANGE_ME__np_PLUS_openssl_rand_hex_23
NATS_MONITORING_PASSWORD=CHANGE_ME__np_PLUS_openssl_rand_hex_23

# ── MinIO (S3-compatible object store) ───────────────────────────────────────
# No `minioadmin` defaults allowed (CLAUDE.md) — both are required.
MINIO_ROOT_USER=CHANGE_ME__minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME__minio_password
# Public host clients use for PRESIGNED object GETs (avatars / guard documents / check-in
# photos). MUST point at this domain's `/minio-files` path — nginx proxies it to MinIO and
# the URL is signed against THIS host (s3.rs). Leave UNSET and presigned URLs fall back to the
# internal `http://minio:9000`, which phones/browsers can't reach → images won't load.
#  • Its HOST must EXACTLY equal the nginx `server_name` (the SigV4 signature binds the host) —
#    a CDN/alt-domain that merely routes here would 403 EVERY object read.
#  • The `pguard` bucket must stay PRIVATE (never `mc anonymous set download`) — the public route
#    is safe only because MinIO 403s unsigned requests. See docs/STAGING-SETUP.md (MinIO bucket).
S3_PUBLIC_URL=https://pguard.innoveraappcenter.com/minio-files

# ── Payment provider (REAL money path: Slip2Go transfer-slip verification) ───
# PAYMENT_PROVIDER selects the money path: `simulated` (default — POST /payments auto-marks the
# estimate paid; NO real money) or `slip2go` (POST /payments/{id}/slip verifies a real PromptPay/
# bank-transfer slip via Slip2Go before stamping the booking paid). Keep `simulated` until the
# Slip2Go secret + receiving account are set, then flip to `slip2go`.
PAYMENT_PROVIDER=simulated
# OUR PromptPay/bank account number — every accepted slip's receiver must match this (anti-fraud).
# REQUIRED when PAYMENT_PROVIDER=slip2go. Account number only — no spaces/dashes.
RECEIVING_ACCOUNT=CHANGE_ME__our_promptpay_or_bank_account_number
# Slip2Go API. Base URL defaults to the production endpoint; override for a sandbox. The SECRET is
# the Bearer token (Slip2Go dashboard). REQUIRED when PAYMENT_PROVIDER=slip2go; leave blank under
# simulated. NOTE: the VPS EGRESS IP must be whitelisted in the Slip2Go dashboard (IP allow-list,
# default `*`, cap 10) or every verify returns an auth error.
SLIP2GO_BASE_URL=https://connect.slip2go.com/api
SLIP2GO_API_SECRET=CHANGE_ME__slip2go_bearer_secret

# ── Grafana (observability is internal-only; not host-published) ─────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME__grafana_password

# ── Browser/CORS + WebSocket Origin allow-list ───────────────────────────────
# The gateway enforces CORS AND checks the WS upgrade `Origin` against this list
# (CORS doesn't cover WebSockets). Must be the public HTTPS origin so the web-admin
# and any browser WS work. Mobile/Bearer clients send no Origin and are unaffected.
CORS_ALLOWED_ORIGINS=https://pguard.innoveraappcenter.com

# ── mediasoup SFU (WebRTC) ───────────────────────────────────────────────────
# The VPS PUBLIC IP — mediasoup advertises it in ICE candidates so phones can reach
# the media plane. WITHOUT a correct public IP, WebRTC calls fail to connect.
MEDIASOUP_ANNOUNCED_IP=CHANGE_ME__vps_public_ip
# WebRTC UDP media range (host-published 1:1 — the documented port exception).
# Narrowed from the prod default (40000-49999) for TWO staging reasons:
#   1. Publishing 10k UDP ports makes `docker compose up` crawl / hit ulimits.
#   2. Tailscale's direct-connection port (UDP 41641) sits INSIDE 40000-49999;
#      mediasoup binding the whole range collides with it on the host.
# 200 ports is ample for staging concurrency and steers clear of 41641. Widen on a
# dedicated media host. (Both the published range AND mediasoup's worker config read
# these, so they stay consistent.)
RTC_MIN_PORT=42000
RTC_MAX_PORT=42199

# ── OTP / SMS (INET CSGAPI gateway) ──────────────────────────────────────────
# Staging defaults SMS OFF via the otp service's `SMS_DISABLED` (set in
# docker-compose.staging.yml as `${SMS_DISABLED:-true}`). These three are STILL
# required for compose interpolation (`${VAR:?}`); they're inert while SMS is
# disabled, so any non-empty placeholder is fine.
#
# The gate is VALUE-AWARE (not presence-based): only a truthy value — true/1/yes/on/y
# — disables SMS; `false`/`0`/empty/UNSET ENABLE real SMS. So to actually send OTP
# SMS: set `SMS_DISABLED=false` BELOW and put REAL INET creds here. (Do NOT remove the
# `SMS_DISABLED` line from the staging compose — without it the service runs with SMS ON.)
INET_SMS_USERNAME=disabled-placeholder
INET_SMS_PASSWORD=disabled-placeholder
INET_SMS_SENDER=PGUARD
# Leave unset (commented) to keep SMS OFF (compose defaults it to "true"). Set to
# "false" to ENABLE real SMS (with real creds above).
# SMS_DISABLED=false

# ── Push notifications (FCM) ─────────────────────────────────────────────────
# No FCM service-account on staging by default → disable push. To enable, set
# FCM_DISABLED=false and mount the service-account JSON at FCM_SERVICE_ACCOUNT_PATH.
FCM_DISABLED=true

# ── Tunables (optional — sensible defaults exist in the compose) ──────────────
RUST_LOG=info
# OTLP trace sampling ratio (0.0–1.0). 0.1 = 10% in prod; raise while debugging.
OTEL_TRACES_SAMPLER_ARG=0.1
# Edge rate-limit tiers (the gateway's own per-IP limiter; nginx adds a coarse layer).
RATE_API_PER_SEC=50
RATE_AUTH_PER_SEC=10
# OTP send/challenge per-IP/min (was 3 — too tight; a clean flow already uses challenge+request).
RATE_OTP_PER_MIN=15
# OTP verify gets its own per-IP bucket so send/challenge churn can't starve a real verification.
RATE_OTP_VERIFY_PER_MIN=30
# Access-token lifetime (minutes).
JWT_EXPIRY_MINUTES=15
# Per-service DB pool sizes (writes via pgbouncer, reads via the replica).
DATABASE_MAX_CONNECTIONS=10
DATABASE_READ_MAX_CONNECTIONS=10

# TURN/STUN (coturn) — calling NAT traversal (Round 1). TURN_SECRET ต้องตรงกับ coturn static-auth-secret.
# host = VPS public domain/IP, port 3478. generate secret: openssl rand -hex 48
TURN_URLS=turn:pguard.innoveraappcenter.com:3478?transport=udp,turn:pguard.innoveraappcenter.com:3478?transport=tcp
TURN_SECRET=replace_me_openssl_rand_hex_48
TURN_EXTERNAL_IP=REPLACE_WITH_VPS_PUBLIC_IP
