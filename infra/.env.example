# pguard v2 — dev infra env (SCAFFOLD STUB)
# Copy to ../infra/.env (gitignored) and adjust as needed:
#   cp infra/.env.example infra/.env
# Compose reads these with sensible inline defaults, so zero-config `up` also works.
# NOTE: dev credentials only. Never reuse these in staging/prod.

# ── PostgreSQL ──
POSTGRES_USER=pguard
POSTGRES_PASSWORD=pguard_dev_pw
POSTGRES_DB=pguard
POSTGRES_PORT=5432

# ── NATS (JetStream) ──
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# ── Redis ──
REDIS_PORT=6379

# ── MinIO (S3-compatible object store) ──
MINIO_ROOT_USER=pguard
MINIO_ROOT_PASSWORD=pguard_dev_pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── OpenTelemetry Collector (OTLP ingress) ──
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# ── Service tracing (C5.1) ──
# Rust services run on the HOST (`cargo run`) and export spans to the collector's
# host-mapped OTLP gRPC port. EXPORT THESE IN THE SHELL that runs the services
# (compose ignores them — they configure the apps, not the stack):
#   export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#   export OTEL_TRACES_SAMPLER_ARG=1.0   # 0.0–1.0 sampling ratio (default 1.0 = all)
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to run logging-only (no exporter).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0
# api-gateway serves /metrics on this admin address (NOT its public edge port 3000).
# Bind to a private/monitoring interface in prod; /metrics is unauthenticated.
# METRICS_ADDR=0.0.0.0:9100

# ── Service secrets (app-level; EXPORT IN THE SHELL that runs `cargo run`) ──
# These configure the Rust apps, not the compose stack. Each service fails fast at startup if
# its required secret is missing. EVENT_SIGNING_SECRET is the HMAC key for signed NATS events
# (shared-events) — producers sign, consumers verify, so a forged event is rejected. Must be
# ≥64 chars and DEDICATED (never the same as JWT_SECRET/SERVICE_JWT_SECRET). For example:
#   export JWT_SECRET=$(openssl rand -hex 48)
#   export SERVICE_JWT_SECRET=$(openssl rand -hex 48)
#   export EVENT_SIGNING_SECRET=$(openssl rand -hex 48)

# ── Prometheus ──
PROMETHEUS_PORT=9090

# ── Grafana (host 3030 → container 3000; 3000=api-gateway, 3001=identity on the host) ──
GRAFANA_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
